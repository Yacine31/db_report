# Copy this file to .env and adapt the values (.env is ignored by git).

# Directory where the reports are written (default: ./output)
# export OUTPUT_DIR="/u04/db_report"

# Root directory of the Data Pump export logs, read by sh/local/check_expdp_log.sh
export EXPDP_DIR="/u04/expdp"

# Directory that contains the Dbvisit Standby dbvctl executable, only needed
# when it is not found automatically (default: /usr/dbvisit/standby)
# export DBV_HOME="/usr/dbvisit/standby"
